@startuml Golem Shopping Architecture

' Define styles
skinparam componentStyle uml2
skinparam backgroundColor #F5F5F5
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 10
skinparam shadowing true
skinparam ArrowColor #666666
skinparam ComponentBackgroundColor #E8E8E8
skinparam ComponentBorderColor #666666

' Define components
actor "User" as user #FFD700

package "Golem Cloud" {
    [API Gateway] as gateway #F9E79F
    [Product Agent] as product #D5F5E3
    [Pricing Agent] as pricing #D6EAF8
    [Inventory Agent] as inventory #FCF3CF
    [Cart Agent] as cart #FADBD8
    [Order Agent] as order #E8DAEF
    [Product Search Agent] as product_search #D1F2EB
    [Order Search Agent] as order_search #D1F2EB
    [Shopping Assistant Agent] as assistant #E8F8F5
    [Manager Agent] as manager #FADBD8
}

' External Services
[AI / LLM Service] as llm #D6EAF8

' Define relationships
user --> gateway : "HTTP Requests\n(REST API Calls)"

gateway --> product : "RPC\nProduct API"
gateway --> pricing : "RPC\nPricing API"
gateway --> inventory : "RPC\nInventory API"
gateway --> cart : "RPC\nCart API"
gateway --> order : "RPC\nOrder API"
gateway --> product_search : "RPC\nProduct Search API"
gateway --> order_search : "RPC\nOrder Search API"
gateway --> assistant : "RPC\nAssistant API"
gateway --> manager : "RPC\nManager API"

' Agent-to-agent communication
cart --> product : "RPC\nGet product info"
cart --> pricing : "RPC\nGet pricing info"
cart --> inventory : "RPC\nCheck availability &\nreserve/release/fulfill stock"
cart --> order : "RPC\nCreate order on confirmation"
order --> product : "RPC\nGet product info"
order --> pricing : "RPC\nGet pricing info"
order --> inventory : "RPC\nReserve / adjust / release inventory"
product_search --> product : "RPC\nGet product info"
product_search --> inventory : "RPC\nGet stock status"

' Shopping Assistant relationships (Autonomous Tool Execution)
assistant --> product_search : "RPC\nSearch products & prices"
assistant --> cart : "RPC\nManage cart & 2-phase checkout"
assistant --> order : "RPC\nGet order details"

' Order Search relationships
order_search --> order : "RPC\nStream & query orders"

' Manager Assistant relationships
manager --> order : "RPC\nModify, ship & cancel orders"
manager --> order_search : "RPC\nSearch system orders"
manager --> product : "RPC\nCheck product specs"
manager --> inventory : "RPC\nCheck stock status"
manager --> product_search : "RPC\nSearch catalog"

' LLM Service connections
assistant --> llm : "API Call"
manager --> llm : "API Call"

' Add notes
note right of gateway
  <b>API Gateway</b>
  - Routes REST API to agents
  - /v1/product/* -> Product Agent
  - /v1/pricing/* -> Pricing Agent
  - /v1/inventory/* -> Inventory Agent
  - /v1/cart/* -> Cart Agent
  - /v1/order/* -> Order Agent
  - /v1/assistant/* -> Shopping Assistant Agent
  - /v1/manager/* -> Manager Agent
  - /v1/product/search -> Product Search Agent
  - /v1/order-search/* -> Order Search Agent
  - Transforms REST to Golem RPC
end note

note right of product
  <b>Product Agent</b>
  - Manages product catalog
  - State managed by Golem Cloud
end note

note right of pricing
  <b>Pricing Agent</b>
  - Manages product pricing
  - Handles discounts/promotions
  - State managed by Golem Cloud
end note

note right of inventory
  <b>Inventory Agent</b>
  - Manages regional product stock
  - Tracks allocations & TTL checkout holds
  - State managed by Golem Cloud
end note

note right of cart
  <b>Cart Agent</b>
  - Manages user shopping carts
  - One cart per user
  - 2-Phase checkout (prepare draft & confirm)
  - State managed by Golem Cloud
end note

note right of order
  <b>Order Agent</b>
  - Manages order lifecycle
  - Handles order processing
  - State management (New/Shipped/Cancelled)
  - State managed by Golem Cloud
end note

note right of product_search
  <b>Product Search Agent</b>
  - Agent per request
  - Gets product info from Product Agents
  - No persistent state
end note

note right of llm
  <b>AI / LLM Providers</b>
  - Google Gemini (native generative AI)
  - OpenRouter / OpenAI-compatible APIs
end note

note right of assistant
  <b>Shopping Assistant Agent</b>
  - Autonomous multi-turn tool calling
  - Tools for search, cart, checkout & orders
  - Synchronous and SSE streaming chat
  - State managed by Golem Cloud
end note

note right of manager
  <b>Manager Agent</b>
  - Autonomous operations tool calling
  - Tools to search, modify, ship & cancel orders
  - Synchronous and SSE streaming chat
  - State managed by Golem Cloud
end note

@enduml
